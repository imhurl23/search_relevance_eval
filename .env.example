# This file documents required names only. Put real values in .env.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=
# Agent model vendors. Each arm needs only its own vendor's key:
#   openai     frontier; --search-mode native uses the Responses web_search tool
#   anthropic  frontier; --search-mode native uses the server-side web_search tool
#   baseten    OSS models over an OpenAI-compatible endpoint; no native search
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BASETEN_API_KEY=
# You.com is the only search API, used by --search-mode harness.
YDC_API_KEY=
CORVUS_CONTACT_EMAIL=
# Set only after confirming the address is a monitored organizational role inbox.
CORVUS_CONTACT_EMAIL_IS_ROLE_ACCOUNT=
# Set only after checking no other machine/service shares this collector identity.
CORVUS_SINGLE_DEPLOYMENT_CONFIRMED=
# Set each only after reviewing and accepting that source's documented terms.
CORVUS_WIKIPEDIA_TERMS_CONFIRMED=
CORVUS_OPENLIGADB_LICENSE_CONFIRMED=
CORVUS_THESPORTSDB_TERMS_CONFIRMED=
NVD_API_KEY=
