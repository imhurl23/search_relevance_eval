# This file documents required names only. Put real values in .env.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=
# Agent model vendors. Each arm needs only its own vendor's key:
#   openai     frontier; --search-mode native uses the Responses web_search tool
#   anthropic  frontier; --search-mode native uses the server-side web_search tool
#   baseten    OSS models over an OpenAI-compatible endpoint; no native search
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BASETEN_API_KEY=
# Serving path. Leave BRAINTRUST_GATEWAY_URL empty to call each vendor directly
# using the three keys above. Set it to https://gateway.braintrust.dev to route
# EVERY model call (agents and judges) through the Braintrust gateway instead —
# then the vendor keys above are unused, and the vendor credentials come from the
# Braintrust org's Settings -> AI Providers. Recorded per run as `serving_path`;
# never mix the two paths inside one study.
BRAINTRUST_GATEWAY_URL=
# Defaults to BRAINTRUST_API_KEY. Set it whenever the org holding the AI
# providers is not the org your experiments are written to — that is the whole
# point of the split, and the fallback would send the wrong org's token.
BRAINTRUST_GATEWAY_API_KEY=
# x-bt-project-name: which Braintrust project the gateway logs model calls to.
BRAINTRUST_GATEWAY_PROJECT=
# x-bt-org-name, for a token whose org is not the one holding the AI providers.
BRAINTRUST_GATEWAY_ORG=
# You.com is the only search API, used by --search-mode harness.
YDC_API_KEY=
CORVUS_CONTACT_EMAIL=
# Set only after confirming the address is a monitored organizational role inbox.
CORVUS_CONTACT_EMAIL_IS_ROLE_ACCOUNT=
# Set only after checking no other machine/service shares this collector identity.
CORVUS_SINGLE_DEPLOYMENT_CONFIRMED=
# Set each only after reviewing and accepting that source's documented terms.
CORVUS_WIKIPEDIA_TERMS_CONFIRMED=
CORVUS_OPENLIGADB_LICENSE_CONFIRMED=
CORVUS_THESPORTSDB_TERMS_CONFIRMED=
NVD_API_KEY=
